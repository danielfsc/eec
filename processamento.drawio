                <mxCell id="2" value="&lt;div&gt;Lendo Um Arquivo&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="4" vertex="1">
                    <mxGeometry x="37.5" y="20" width="340" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="5" value="1) Carrega o arquivo com Pandas&lt;div&gt;&lt;div style=&quot;color: rgb(175, 175, 175); background-color: rgb(30, 30, 30); font-family: &amp;quot;Fira Code&amp;quot;, Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; line-height: 21px; white-space: pre;&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&lt;span style=&quot;color: rgb(175, 175, 175);&quot;&gt;data_raw = pd.read_csv(&lt;/span&gt;&lt;span style=&quot;color: rgb(130, 182, 209);&quot;&gt;file&lt;/span&gt;&lt;span style=&quot;color: rgb(175, 175, 175);&quot;&gt;, &lt;/span&gt;&lt;span style=&quot;color: rgb(130, 182, 209);&quot;&gt;sep&lt;/span&gt;&lt;span style=&quot;color: rgb(175, 175, 175);&quot;&gt;=&lt;/span&gt;&lt;span style=&quot;color: rgb(170, 122, 102);&quot;&gt;&quot; &quot;&lt;/span&gt;&lt;span style=&quot;color: rgb(175, 175, 175);&quot;&gt;, &lt;/span&gt;&lt;span style=&quot;color: rgb(130, 182, 209);&quot;&gt;names&lt;/span&gt;&lt;span style=&quot;color: rgb(175, 175, 175);&quot;&gt;=cfg.electrode_labels)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;" parent="4" vertex="1">
                    <mxGeometry x="37.5" y="70" width="342.5" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="6" value="2) Converte para Numpy Array&lt;span style=&quot;font-family: monospace; font-size: 0px; text-align: start; white-space: nowrap;&quot;&gt;%3CmxGraphModel%3E%3Croot%3E%3CmxCell%20id%3D%220%22%2F%3E%3CmxCell%20id%3D%221%22%20parent%3D%220%22%2F%3E%3CmxCell%20id%3D%222%22%20value%3D%221)%20Carrega%20o%20arquivo%20com%20Pandas%22%20style%3D%22rounded%3D0%3BwhiteSpace%3Dwrap%3Bhtml%3D1%3B%22%20vertex%3D%221%22%20parent%3D%221%22%3E%3CmxGeometry%20x%3D%2277.5%22%20y%3D%2290%22%20width%3D%22342.5%22%20height%3D%2230%22%20as%3D%22geometry%22%2F%3E%3C%2FmxCell%3E%3C%2Froot%3E%3C%2FmxGraphModel%3E&lt;/span&gt;&lt;div&gt;&lt;div style=&quot;text-align: left; color: rgb(175, 175, 175); background-color: rgb(30, 30, 30); font-family: &amp;quot;Fira Code&amp;quot;, Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; line-height: 21px; white-space: pre;&quot;&gt;&lt;font style=&quot;font-size: 6px;&quot;&gt;&lt;span style=&quot;color: rgb(175, 175, 175);&quot;&gt;data_raw = np.transpose(data_raw.to_numpy().astype(&lt;/span&gt;&lt;span style=&quot;color: rgb(68, 166, 146);&quot;&gt;float&lt;/span&gt;&lt;span style=&quot;color: rgb(175, 175, 175);&quot;&gt;))&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;" parent="4" vertex="1">
                    <mxGeometry x="37.5" y="130" width="342.5" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="7" value="&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;3) Corrige os valores inteiros para 24 bits&lt;/span&gt;&lt;br style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;&lt;div style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); background-color: rgb(30, 30, 30); font-family: &amp;quot;Fira Code&amp;quot;, Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; line-height: 21px; white-space: pre;&quot;&gt;&lt;div style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); text-align: left;&quot;&gt;&lt;font style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); line-height: 7.2px;&quot;&gt;&lt;span style=&quot;scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); background-color: rgb(30, 30, 30);&quot;&gt;&lt;font style=&quot;scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); font-size: 6px; line-height: 3.6px; color: rgb(255, 255, 255);&quot;&gt;data_np, changed_values_on_wraparound = ft.fix_integer_wraparound(data_raw)&lt;br style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); font-size: 6px; line-height: 3.6px; background-color: light-dark(rgb(30, 30, 30), rgb(211, 211, 211));&quot;&gt;&lt;font style=&quot;scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); color: rgb(255, 255, 255);&quot;&gt;data_np = np.ascontiguousarray(data_np)&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;" parent="4" vertex="1">
                    <mxGeometry x="37.5" y="190" width="342.5" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="15" value="&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;4) Aplicando os filtros&lt;/span&gt;&lt;br style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;&lt;div style=&quot;scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); background-color: rgb(30, 30, 30); font-family: &amp;quot;Fira Code&amp;quot;, Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; line-height: 21px; white-space: pre;&quot;&gt;&lt;div style=&quot;scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); text-align: left;&quot;&gt;&lt;div style=&quot;line-height: 21px;&quot;&gt;&lt;span&gt;&lt;font style=&quot;font-size: 9px; color: rgb(255, 255, 255);&quot;&gt;data_np, filter_info = ft.apply_filter(data_np, cfg)&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;" parent="4" vertex="1">
                    <mxGeometry x="37.5" y="270" width="342.5" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="16" value="&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;5) Calculando o perfil espectral por blocos&lt;/span&gt;&lt;br style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;&lt;div style=&quot;scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); background-color: rgb(30, 30, 30); font-family: &amp;quot;Fira Code&amp;quot;, Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; line-height: 21px; white-space: pre;&quot;&gt;&lt;div style=&quot;scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); text-align: left;&quot;&gt;&lt;div style=&quot;line-height: 21px;&quot;&gt;&lt;div style=&quot;line-height: 21px;&quot;&gt;&lt;font style=&quot;font-size: 6px; color: rgb(255, 255, 255);&quot;&gt;profile = ut.spectral_profile_blocked(data_np, cfg.sampling_frequency, cfg.block_time)&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;" parent="4" vertex="1">
                    <mxGeometry x="36.25" y="330" width="342.5" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="17" value="&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;6) Calculando as métricas de controle de qualidade&lt;/span&gt;&lt;br style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;&lt;div style=&quot;scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); background-color: rgb(30, 30, 30); font-family: &amp;quot;Fira Code&amp;quot;, Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; line-height: 21px; white-space: pre;&quot;&gt;&lt;div style=&quot;scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); text-align: left;&quot;&gt;&lt;div style=&quot;line-height: 21px;&quot;&gt;&lt;div style=&quot;line-height: 21px;&quot;&gt;&lt;div style=&quot;color: rgb(175, 175, 175); line-height: 21px;&quot;&gt;&lt;font style=&quot;font-size: 6px;&quot;&gt;&lt;span style=&quot;color: rgb(175, 175, 175);&quot;&gt;metrics = ut.quality_control_metrics(data_raw, data_np, &lt;/span&gt;&lt;span style=&quot;color: rgb(130, 182, 209);&quot;&gt;filtering_info&lt;/span&gt;&lt;span style=&quot;color: rgb(175, 175, 175);&quot;&gt;=filter_info, &lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(175, 175, 175); line-height: 21px;&quot;&gt;&lt;font style=&quot;font-size: 6px;&quot;&gt;&lt;span style=&quot;color: rgb(130, 182, 209);&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;subject_id&lt;/span&gt;&lt;span style=&quot;color: rgb(175, 175, 175);&quot;&gt;=subject_id, &lt;/span&gt;&lt;span style=&quot;color: rgb(130, 182, 209);&quot;&gt;file_name&lt;/span&gt;&lt;span style=&quot;color: rgb(175, 175, 175);&quot;&gt;=&lt;/span&gt;&lt;span style=&quot;color: rgb(130, 182, 209);&quot;&gt;file&lt;/span&gt;&lt;span style=&quot;color: rgb(175, 175, 175);&quot;&gt;.name, &lt;/span&gt;&lt;span style=&quot;color: rgb(130, 182, 209);&quot;&gt;eeg_task&lt;/span&gt;&lt;span style=&quot;color: rgb(175, 175, 175);&quot;&gt;=subject_state, &lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(175, 175, 175); line-height: 21px;&quot;&gt;&lt;font style=&quot;font-size: 6px;&quot;&gt;&lt;span style=&quot;color: rgb(130, 182, 209);&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;n_wraparound&lt;/span&gt;&lt;span style=&quot;color: rgb(175, 175, 175);&quot;&gt;=changed_values_on_wraparound)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;" parent="4" vertex="1">
